{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-forms-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral, Effect-native form validation and state, plus Svelte 5 runes bindings",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-forms.git"
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "clean": "vp run -r clean",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only && vp fmt",
    "release": "vp run -r build && pnpm -r --filter './packages/*' publish --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "effect": "catalog:",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
