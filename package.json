{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-forms-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral, Effect-native form validation and state, plus Svelte 5 runes bindings",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-forms.git"
  },
  "type": "module",
  "scripts": {
    "clean": "vp run -r clean",
    "prepare": "vp config && effect-tsgo patch --typescript --oxlint",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only && vp fmt",
    "release": "vp run -r build && pnpm -r --filter './packages/*' publish --access public --no-git-checks --ignore-scripts && changeset tag",
    "fallow": "fallow --summary",
    "fallow:audit": "fallow audit"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@effect/docgen": "catalog:",
    "@effect/language-service": "catalog:",
    "@effect/tsgo": "catalog:",
    "@mpsuesser/oxlint-plugin-effect": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-istanbul": "catalog:",
    "effect": "catalog:",
    "effect-solutions": "catalog:",
    "fallow": "catalog:",
    "happy-dom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.18.0"
}
