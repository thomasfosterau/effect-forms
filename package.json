{
  "$schema": "https://www.schemastore.org/package",
  "name": "effect-forms-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral, Effect-native form validation and state, plus Svelte 5 runes bindings",
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-forms.git"
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "test": "vp run -r test",
    "build": "vp run -r build",
    "clean": "vp run -r clean",
    "prepare": "effect-language-service patch",
    "changeset": "changeset",
    "version": "changeset version && vp fmt",
    "release": "vp run -r build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@effect/language-service": "^0.87.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.2",
    "effect": "4.0.0-beta.102",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.5",
    "vite-plus": "0.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.18.0"
}
