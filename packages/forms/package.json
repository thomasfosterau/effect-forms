{
  "name": "@thomasfosterau/effect-forms",
  "version": "0.5.0",
  "description": "Framework-neutral, Effect-native form validation and state — schema-driven validation, nested errors, posted-value retention, and native constraints, on Effect Schema.",
  "keywords": [
    "effect",
    "form-validation",
    "forms",
    "functional-programming",
    "schema",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-forms/tree/trunk/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-forms/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-forms.git",
    "directory": "packages/forms"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Coerce": {
      "types": "./dist/Coerce.d.ts",
      "import": "./dist/Coerce.js"
    },
    "./Command": {
      "types": "./dist/Command.d.ts",
      "import": "./dist/Command.js"
    },
    "./Constraints": {
      "types": "./dist/Constraints.d.ts",
      "import": "./dist/Constraints.js"
    },
    "./Errors": {
      "types": "./dist/Errors.d.ts",
      "import": "./dist/Errors.js"
    },
    "./Field": {
      "types": "./dist/Field.d.ts",
      "import": "./dist/Field.js"
    },
    "./Focus": {
      "types": "./dist/Focus.d.ts",
      "import": "./dist/Focus.js"
    },
    "./Form": {
      "types": "./dist/Form.d.ts",
      "import": "./dist/Form.js"
    },
    "./FormBuilder": {
      "types": "./dist/FormBuilder.d.ts",
      "import": "./dist/FormBuilder.js"
    },
    "./FormData": {
      "types": "./dist/FormData.d.ts",
      "import": "./dist/FormData.js"
    },
    "./Issues": {
      "types": "./dist/Issues.d.ts",
      "import": "./dist/Issues.js"
    },
    "./Mode": {
      "types": "./dist/Mode.d.ts",
      "import": "./dist/Mode.js"
    },
    "./Path": {
      "types": "./dist/Path.d.ts",
      "import": "./dist/Path.js"
    },
    "./Result": {
      "types": "./dist/Result.d.ts",
      "import": "./dist/Result.js"
    },
    "./State": {
      "types": "./dist/State.d.ts",
      "import": "./dist/State.js"
    },
    "./Validate": {
      "types": "./dist/Validate.d.ts",
      "import": "./dist/Validate.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-ext": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-ext": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
