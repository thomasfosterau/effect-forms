  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@thomasfosterau/effect-ext": "catalog:"
  },
  "peerDependencies": {
    "@thomasfosterau/effect-ext": "catalog:peers",
    "effect": "catalog:peers"
  },
  "engines": {
    "node": ">=22.18.0"
  }
