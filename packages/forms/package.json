{
  "name": "@thomasfosterau/effect-forms",
  "version": "0.4.1",
  "description": "Framework-neutral, Effect-native form validation and state — schema-driven validation, nested errors, posted-value retention, and native constraints, on Effect Schema.",
  "keywords": [
    "effect",
    "form-validation",
    "forms",
    "functional-programming",
    "schema",
    "typescript",
    "validation"
  ],
  "homepage": "https://github.com/thomasfosterau/effect-forms/tree/trunk/packages/forms#readme",
  "bugs": {
    "url": "https://github.com/thomasfosterau/effect-forms/issues"
  },
  "license": "MIT",
  "author": "Thomas Foster <me@thomasfoster.au>",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomasfosterau/effect-forms.git",
    "directory": "packages/forms"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
